# Copy to apps/<app>/.env.local (local dev) and add the same names in Vercel > Project > Settings > Environment Variables.
# Keys are read only by the serverless function /api/spec. They are never sent to the browser.
GROQ_API_KEY=
# Optional extra providers. The first one with a key is used, in this order: groq, openai, anthropic.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider and/or model
SPECTER_PROVIDER=groq
GROQ_MODEL=

# Studio model libraries (optional). Poly Haven and the built-in catalogue need no key.
POLY_PIZZA_API_KEY=
SMITHSONIAN_API_KEY=
# Optional AI generation (paid Meshy plan)
MESHY_API_KEY=
